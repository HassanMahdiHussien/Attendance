# Copy to /root/displanery-server.env, mode 0600, on the application VPS.
DOMAIN=app.example.com
ADMIN_EMAIL=admin@example.com
DATA_DEVICE=/dev/disk/by-id/replace-with-volume-id
# Formatting a blank device requires both confirmations. Leave empty when reusing LUKS.
CONFIRM_FORMAT_DEVICE=
CONFIRM_FORMAT_SERIAL=
REPO_URL=git@github.com:owner/displanery.git
TLS_MODE=letsencrypt
SSH_PORT=22
SWAP_SIZE=2G
