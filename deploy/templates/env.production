APP_NAME=Displanery
APP_ENV=production
APP_DEBUG=false
APP_URL=https://@@DOMAIN@@
APP_TIMEZONE=Asia/Baghdad
APP_KEY=@@APP_KEY@@
ANTHROPIC_API_KEY=
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=displanery
DB_USERNAME=displanery
DB_PASSWORD=@@DB_PASSWORD@@
DB_DRILL_HOST=127.0.0.1
DB_DRILL_PORT=3306
DB_DRILL_DATABASE=displanery_restore_drill
DB_DRILL_USERNAME=displanery_drill
DB_DRILL_PASSWORD=@@DB_DRILL_PASSWORD@@
BACKUPS_ENABLED=true
BACKUP_DISKS=backup-sftp
BACKUP_ARCHIVE_PASSWORD=@@BACKUP_ARCHIVE_PASSWORD@@
BACKUP_NOTIFY_EMAIL=@@ADMIN_EMAIL@@
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USERNAME=displanery-backup
BACKUP_SFTP_PRIVATE_KEY=/home/deploy/.ssh/backup_ed25519
BACKUP_SFTP_ROOT=/displanery
BACKUP_SFTP_FINGERPRINT=
HEALTHCHECK_HEARTBEAT_URL=
HEALTHCHECK_BACKUP_URL=
HEALTHCHECK_RESTORE_DRILL_URL=
HEALTHCHECK_DEADLINE_ALERTS_URL=
HEALTHCHECK_QUEUE_FAILURES_URL=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=@@ADMIN_EMAIL@@
MAIL_FROM_NAME=Displanery
DISPLANERY_CHROME_PATH=/usr/local/bin/chrome-headless-shell
